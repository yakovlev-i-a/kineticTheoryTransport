#!/bin/sh
# Build libkineticTheoryTransport.
#
# The chemistryModel machinery (standard<standardKinetic<...>>) is statically
# instantiated in chemistryModel/standardChemistryModels.C and compiled into
# this library, so no dynamicCode template override is needed.
cd "${0%/*}" || exit 1

echo "=== Building libkineticTheoryTransport ==="
wmake libso || { echo "wmake failed"; exit 1; }

echo "Done."
